{
  "id": "T2b",
  "title": "approval deny branch of T2",
  "input": "rename Hello to Hi in src/greeting.ts",
  "repo": {
    "id": "basic",
    "path": "fixtures/basic",
    "commit": "local-dev",
    "initialTree": ["src/hello.ts", "src/greeting.ts", "tmp/scratch.txt"]
  },
  "model": {
    "mode": "recorded",
    "fixture": "t2-recorded-v1",
    "retries": 0
  },
  "approval": {
    "mode": "ask",
    "decision": "deny",
    "timeoutMs": 2000
  },
  "expectedTools": {
    "mode": "exact",
    "sequence": [
      { "name": "read", "input": { "path": "src/greeting.ts" } },
      {
        "name": "edit",
        "input": {
          "path": "src/greeting.ts",
          "from": "Hello from Kern",
          "to": "Hi from Kern"
        }
      }
    ]
  },
  "expect": {
    "errorCode": "APPROVAL_DENIED",
    "eventOrder": ["approval-requested", "tool-call-cancelled"],
    "unchangedFiles": ["src/greeting.ts", "src/hello.ts"]
  },
  "budget": {
    "maxTurns": 3,
    "maxInputTokens": 4000,
    "maxOutputTokens": 2000,
    "maxWallTimeMs": 15000
  },
  "killPoints": [],
  "invariants": [
    "tool-use-pairing",
    "tool-event-pairing",
    "seq-monotonic",
    "pending-empty-at-terminal"
  ]
}
