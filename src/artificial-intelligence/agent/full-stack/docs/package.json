{
  "name": "agent-fullstack-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "bun run src/scripts/validate.ts",
    "build": "bun run validate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run validate && tsc --noEmit && oxlint . && oxfmt --check ."
  },
  "dependencies": {
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  }
}
