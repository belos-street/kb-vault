# ── LLM 配置（OpenAI 兼容端点）─────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash

# ── 会话与用户 ─────────────────────────────────────────────
# 当前登录用户：决定工具能操作哪些订单（越权按不存在处理）
CURRENT_USER_ID=u_001

# ── 运行时参数 ─────────────────────────────────────────────
# 一次 turn 最多调用模型几次（不是工具调用次数）
MAX_MODEL_CALLS=8
# 模型请求的重试次数（只对 429 / 5xx / 连接错误）
MAX_RETRIES=2
# 估算 token 超过该值时触发压缩
COMPACT_TRIGGER_TOKENS=6000
# 压缩时保留最近多少条消息
COMPACT_KEEP_MESSAGES=8
