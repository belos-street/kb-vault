{
  "name": "kb-retrieval-demo",
  "version": "0.1.0",
  "private": true,
  "description": "第四阶段实验：Milvus / Qdrant / ElasticSearch / Neo4j 检索链路",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "demo:milvus": "bun run src/milvus.ts",
    "demo:qdrant": "bun run src/qdrant.ts",
