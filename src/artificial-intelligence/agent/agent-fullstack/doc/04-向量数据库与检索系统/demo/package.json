    "fflate": "^0.8.3",
    "ioredis": "^5.9.0",
    "mammoth": "^1.13.0",
    "neo4j-driver": "^6.0.0",
    "pg": "^8.21.0",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "@types/turndown": "^5.0.6",
    "oxfmt": "^0.56.0",
