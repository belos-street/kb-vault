{
  "name": "hono-enterprise-rest-api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7",
    "@scalar/hono-api-reference": "^0.12.4",
    "dotenv": "^18.0.3",
    "hono": "^4.13.9",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "prisma": "7",
    "typescript": "^7.0.2"
  }
}
